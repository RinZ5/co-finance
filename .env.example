# Your Finnhub API key for stock market data (shared by backend and gateway)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Comma-separated list of allowed frontend domains for backend CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production gateway connection configuration (for development use)
# Replace with your production VM IP address
FINNHUB_WS_URL=ws://your_production_vm_ip:8081/ws

# Production gateway secret (must match production gateway secret)
# Replace with your actual production gateway secret
GATEWAY_SECRET=your_production_gateway_secret

# Frontend backend connection configuration
VITE_BACKEND_URL=http://localhost:8080
